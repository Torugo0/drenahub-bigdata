# Diretório de chegada dos arquivos JSONL. O padrão é ./chegada.
DRENAHUB_DATA_DIR=chegada
# Notificações locais de falha da DAG (padrão: entrega_local/evidencias).
DRENAHUB_ALERT_DIR=entrega_local/evidencias
# Padrão: 2 novas tentativas; definir 0 apenas em teste isolado de falha.
DRENAHUB_TASK_RETRIES=2

# Databricks: configurar no workspace ou como variáveis de ambiente locais.
# Nunca registrar credenciais neste arquivo nem no Git.
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default
DATABRICKS_VOLUME=drenahub_raw
